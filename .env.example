# ============================================================
# CIG-MANUFACTURING — Variables de entorno
# Copia este archivo como ".env" y ajusta los valores:
#   cp .env.example .env
#
# El script setup.sh puede generar este archivo automáticamente.
# ============================================================

# --- Base de datos (SQLite) ---------------------------------
# IMPORTANTE: usa una RUTA ABSOLUTA al archivo de la base de
# datos en TU servidor. El modo de producción (standalone)
# NO resuelve bien rutas relativas.
# Ejemplo Linux:   file:/opt/cig-manufacturing/db/custom.db
# Ejemplo Windows: file:C:/cig-manufacturing/db/custom.db
DATABASE_URL=file:/ruta/absoluta/a/cig-manufacturing/db/custom.db

# --- Seguridad ----------------------------------------------
# Clave secreta para firmar las sesiones JWT (cookies httpOnly).
# Genera una aleatoria, por ejemplo con:
#   openssl rand -hex 32
# Si no la defines, se usa una clave de desarrollo (NO recomendado).
AUTH_SECRET=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# --- Servidor (opcional) ------------------------------------
# Puerto y dirección de escucha (por defecto 3000 / 0.0.0.0)
# PORT=3000
# HOSTNAME=0.0.0.0
