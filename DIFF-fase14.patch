++    env.update({"PORT": "3400", "HOSTNAME": "0.0.0.0", "COOKIE_INSEGURA_HTTP": "1"})
++    log = open("/tmp/cig-manufacturing-test-branding.log", "w")
++    proc = subprocess.Popen(
++        ["bash", "start.sh"], cwd=PROYECTO, env=env,
